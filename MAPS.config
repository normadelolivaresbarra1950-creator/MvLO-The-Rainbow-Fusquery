# MvLO - MAPS.config - v2.3.0.1
# Author: MatteoMVLO
# Rainbow Fusquery Map Support

[MOD_INFO]
mod=Rainbow Fusquery
version=v2.3.0.1
mapsSupport=all

[MAPS_LIST]
# Todos los mapas compatibles con Rainbow Fusquery
vanilla_grass=true
vanilla_desert=true
vanilla_ice=true
vanilla_castle=true
vanilla_ghost=true
vanilla_underground=true
custom_rainbow_road=true
custom_fusquery_arena=true

[MAPS_SETTINGS]
[vanilla_grass]
enabled=true
rainbowTrailVisible=true
trailOpacity=0.8
glow=true
performance=high

[vanilla_desert]
enabled=true
rainbowTrailVisible=true
trailOpacity=0.9
glow=true
fixSandPaletteBug=true

[vanilla_ice]
enabled=true
rainbowTrailVisible=true
trailOpacity=1.0
glow=true
iceEffect=rainbow_ice
fixBlueScreen=true

[vanilla_castle]
enabled=true
rainbowTrailVisible=true
glow=true
darkMapFix=true

[custom_rainbow_road]
id=rainbow_road_fusquery
displayName=Rainbow Road Fusquery
enabled=true
creator=MatteoMVLO
file=maps/rainbow_road.json
size=large
theme=rainbow
music=rainbow_road_music.ogg
background=rainbow_sky
compatible=true
unlockable=false

[MAPS_FIXES_V2.3.0.1]
fixTrailInvisibleInDarkMaps=true
fixCrashOnCustomMaps=true
fixPaletteOnIceMap=true
fixOnlineDesyncOnMapChange=true

# END MAPS.config
