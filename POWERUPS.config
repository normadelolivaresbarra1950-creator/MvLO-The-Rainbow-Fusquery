# MvLO - The Rainbow Fusquery
# POWERUPS.config - v2.3.0.1 Hotfix Parched
# Author: MatteoMVLO
# Compatible with: More Power-Ups Mod

[MOD_INFO]
modName=Rainbow Fusquery
version=v2.3.0.1-hotfix-patched
author=MatteoMVLO
powerUpsSupport=true

[POWERUPS_GENERAL]
enabled=true
allowAllPowerUps=true
customPowerUps=true
rainbowCompatible=true
onlineSync=true

# Lista de PowerUps compatibles con Rainbow Fusquery
[POWERUPS_COMPATIBILITY]
Mushroom=true
FireFlower=true
IceFlower=true
SuperStar=true
MetalCap=true
InvisibleCap=true
HammerSuit=true
BoomerangSuit=true
RainbowStar=true
CustomRainbowPower=true

[POWERUPS_STATS]

# Cuando agarra Mushroom
[Mushroom]
enabled=true
effect=big
colorEffect=rainbow
scale=1.2
duration=-1
rainbowTrailIntensity=1.5
sound=powerup.wav

# Cuando agarra Fire Flower
[FireFlower]
enabled=true
effect=fire
colorEffect=rainbow_fire
fireColor=rainbow
projectile=rainbow_fireball
projectileSpeed=12
damage=1
rainbowTrailIntensity=2.0

# Cuando agarra Ice Flower
[IceFlower]
enabled=true
effect=ice
colorEffect=rainbow_ice
iceColor=rainbow
projectile=rainbow_iceball
freezeDuration=2.5
rainbowTrailIntensity=1.8

# Cuando agarra Super Star - EL MAS IMPORTANTE PARA RAINBOW
[SuperStar]
enabled=true
effect=invincible_rainbow
colorEffect=super_rainbow
duration=15.0
speedBoost=1.5
invincible=true
rainbowTrailIntensity=3.0
glow=true
glowColor=rainbow
music=rainbow_star_music

# Cuando agarra Rainbow Star (custom powerup tuyo)
[RainbowStar]
enabled=true
effect=ultra_rainbow
colorEffect=ultra_rainbow
duration=20.0
speedBoost=2.0
jumpBoost=1.5
invincible=true
rainbowTrailIntensity=5.0
particleCount=50
glow=true
ultraGlow=true
customAbility=rainbowDash
customAbilityKey=Q

[CUSTOM_POWERUPS]

# Tu powerup custom de Rainbow Fusquery
[RainbowBurst]
id=rainbow_burst
displayName=Rainbow Burst
enabled=true
description=Explota en colores rainbow!
duration=5.0
effectType=explosion
explosionRadius=5.0
explosionColor=rainbow
damage=2
knockback=3.0
cooldown=10.0
icon=sprites/rainbow_burst_icon.png

[ColorChange]
id=color_change
displayName=Color Change
enabled=true
description=Cambia el color del rainbow!
duration=0.5
effectType=color
changeSpeed=5.0
cooldown=2.0

[SETTINGS]
# Configuracion que el usuario puede cambiar
userCanDisableTrail=false
userCanDisableGlow=true
highPerformanceMode=false
lowEndPCSupport=true
onlineCompatibility=true

[FIXES_V2.3.0.1]
# Fixes de esta hotfix
fixDesyncOnPowerUp=true
fixTrailNotShowingWithPowerUp=true
fixColorBugWhen
