# All Objects Compatibility

[MOD_INFO]
mod=Rainbow Fusquery
version=v2.3.0.1
objectsSupport=all

[OBJECTS_LIST]
block=true
brickBlock=true
questionBlock=true
pipe=true
spring=true
platform=true
movingPlatform=true
spike=true
lava=true
coin=true
powerUpBlock=true

[OBJECTS_INTERACTION]

[block]
enabled=true
collision=true
